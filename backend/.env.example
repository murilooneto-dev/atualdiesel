# Runtime (app queries): Supavisor pooler — required in serverless (Vercel), avoids opening a
# raw connection per invocation. Region must match the Supabase project's region (e.g. sa-east-1).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations only (prisma migrate): direct connection, not used at runtime.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_JWT_SECRET="[SUPABASE_JWT_SECRET]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SERVICE_ROLE_KEY]"

PORT=3000
FRONTEND_URL="http://localhost:5173"
